# Variable de entorno leida por la extension Rest Client de VS Code
@baseUrl = {{ $dotenv API_URL }}

# Sustitye esta variable por un _id correcto y que exista para probar las rutas por el id
@productId = 6af9e3704de152f49a042297

### 1.- Crear un nuevo producto (POST)
# El JSON es el cuerpo de la peticion que recibira req.body que tenemos en los controllers
POST {{baseUrl}}
Content-Type: application/json
{
    "name": "Monitor Gaming 27 Pulgadas",
    "description": "Panel IPS 165Hz 1ms QHD",
    "price": 249.99,
    "stock": 15,
    "category": "perifericos"
}

### 2.- Obtener todos los productos (GET)
# Consulta la coleccion completa 
GET {{baseUrl}}
Accept: application/json

### 3.- Obtener un producto, su detalle mediante el id
# La variable productId se inserta en el segmento dinamico de la ruta
GET {{baseUrl}}/{{productId}}
Accept: application/json

### 4.- Actualizar un producto existente (PUT)
# Este controlador actualiza solos los campos enviados mediante el findByIdAndUpdate
PUT {{baseUrl}}/{{productId}}
Content-Type: application/json

{
  "price": 219.99,
  "stock": 10
}

### 5.- Eliminar un producto (DELETE)
DELETE {{baseUrl}}/{{productId}}

### 6.- Prueba de error 404
# Comprobar la respuesta del middleware
GET {{baseUrl}}/ruta-falsa

### 7.- Prueba de error 400/500 (id cpn formatoinvalido
GET {{baseUrl}}/123-id-invalido